{
  "rule_name": "R07_forced_recapture",
  "description": "Fires when the played move is a forced recapture (only legal response that holds material). Side-specific framing.",
  "fact_glossary": {
    "played_san": "SAN of the move",
    "captured_piece_type": "Piece that was just recaptured",
    "mover_is_user": "true if the player who just moved is the user"
  },
  "requires": ["played_san"],
  "select_variant": [
    {"when": {"mover_is_user": false}, "variant": "opp"},
    {"variant": "user"}
  ],
  "variants": {
    "user": "{played_san} — only move. Takes back the {captured_piece_type}.",
    "opp": "{played_san}. Opponent forced to recapture the {captured_piece_type}."
  }
}
