    "target_square": "Square of the attacked piece"
  },
  "requires": ["played_san", "discovered_attacker_piece_type", "target_piece_type", "target_square"],
  "variants": {
    "default": "{played_san} uncovers the {discovered_attacker_piece_type} hitting the {target_piece_type} on {target_square}."
  }
