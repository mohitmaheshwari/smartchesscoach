# Chess Coach AI - Frontend Builder
# Builds the React app and copies the output to /output (bind-mounted to host)
#
# This is a "run once" container: builds → copies → exits

FROM node:20-slim AS builder

WORKDIR /app/frontend

# Copy package files
COPY frontend/package.json frontend/yarn.lock ./

# Install dependencies
# --ignore-engines: @capacitor/cli requires Node >=22, but it is APK build
# tooling that never runs here -- the web bundle only imports
# @capacitor/core, /app and /browser. Bumping this image to Node 22 would
# change the production web build for no benefit.
RUN yarn install --frozen-lockfile --ignore-engines --non-interactive

# Copy frontend source
COPY frontend/ ./

# Build the React app (uses .env.production for REACT_APP_BACKEND_URL)
RUN yarn build

# ============================================
# Output stage: copy build to /output
# ============================================
FROM alpine:latest

COPY --from=builder /app/frontend/build /build

# On startup, publish the build into the bind-mounted /output directory.
#
# This used to be `rm -rf /output/* && cp -r /build/* /output/`, which deleted
# the LIVE docroot before copying anything in. On 2026-10-06 the rm failed part
# way, the && chain stopped, and chessguru.ai served a 500 to every visitor
# until the bundle was restored by hand. The publish script stages the new build
# beside the live one and swaps only after checking it -- see the file.
COPY scripts/publish_frontend_output.sh /usr/local/bin/publish-frontend
RUN chmod +x /usr/local/bin/publish-frontend

CMD ["/usr/local/bin/publish-frontend"]
