# Chess Coach AI - Backend Dockerfile
# Standalone backend service for development or microservices deployment

FROM python:3.11-slim

# Install system dependencies including Stockfish chess engine
# build-essential is required: maia2/otter-chess pull in fastchess, which
# has no wheel for this platform and compiles from source. Without gcc the
# image build fails at `pip install -r requirements-human-policy.txt`.
RUN apt-get update && apt-get install -y \
    stockfish \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Official Stockfish 17.1 AVX2 build for GAME ANALYSIS (config.ANALYSIS_STOCKFISH_PATH).
# Same version as the Debian package above, 2.7x faster, identical search
# (bench node counts match). Pinned by checksum; a CPU without AVX2 falls back
# to /usr/games/stockfish at runtime.
ARG STOCKFISH_AVX2_URL=https://github.com/official-stockfish/Stockfish/releases/download/sf_17.1/stockfish-ubuntu-x86-64-avx2.tar
ARG STOCKFISH_AVX2_SHA256=09e953222dbe80aaea5c33dab265413b295cb8376418445c877708c61e31987d
RUN curl -fsSL -o /tmp/sf.tar "$STOCKFISH_AVX2_URL" \
    && echo "$STOCKFISH_AVX2_SHA256  /tmp/sf.tar" | sha256sum -c - \
    && tar -xf /tmp/sf.tar -C /tmp \
    && install -m 0755 /tmp/stockfish/stockfish-ubuntu-x86-64-avx2 /usr/local/bin/stockfish-avx2 \
    && rm -rf /tmp/sf.tar /tmp/stockfish

WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt backend/requirements-human-policy.txt ./
RUN pip install --no-cache-dir -r requirements.txt --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ \
    && pip install --no-cache-dir -r requirements-human-policy.txt

# Copy backend source code
COPY backend/ ./backend/

# Bake the commit that produced this image into /api/health (2026-08-07,
# see server.py health()) so verify_deployment.py can confirm a deploy
# actually reached prod. .dockerignore excludes .git, so this must be
# passed in at build time, not read from inside the container.
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

# Set working directory to backend
WORKDIR /app/backend

# Expose the API port
EXPOSE 8002

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8002/api/health || exit 1

# Run the FastAPI server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8002"]
