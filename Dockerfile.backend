# Chess Coach AI - Backend Dockerfile
# Standalone backend service for development or microservices deployment

FROM python:3.11-slim

# Install system dependencies including Stockfish chess engine
# build-essential is required: maia2/otter-chess pull in fastchess, which
# has no wheel for this platform and compiles from source. Without gcc the
# image build fails at `pip install -r requirements-human-policy.txt`.
RUN apt-get update && apt-get install -y \
    stockfish \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies
COPY backend/requirements.txt backend/requirements-human-policy.txt ./
RUN pip install --no-cache-dir -r requirements.txt --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ \
    && pip install --no-cache-dir -r requirements-human-policy.txt

# Copy backend source code
COPY backend/ ./backend/

# Bake the commit that produced this image into /api/health (2026-08-07,
# see server.py health()) so verify_deployment.py can confirm a deploy
# actually reached prod. .dockerignore excludes .git, so this must be
# passed in at build time, not read from inside the container.
ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT
ARG BUILD_TIMESTAMP=unknown
ENV BUILD_TIMESTAMP=$BUILD_TIMESTAMP

# A build arg can be forgotten, and on 2026-09-19 it was: production answered
# git_commit "unknown" and nobody could say what was serving users without
# opening a shell inside the container. A build arg can also be WRONG -- it is
# whatever string the operator typed, and nothing checks it against the source
# actually copied in.
#
# This fingerprint is derived from the copied source itself, during the build,
# so it cannot be omitted and cannot disagree with what shipped. Compare it
# against `python backend/scripts/source_fingerprint.py` run on any checkout
# to find out exactly which tree a running container is serving.
RUN find /app/backend -name '*.py' -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    | sha256sum \
    | cut -d' ' -f1 > /app/SOURCE_FINGERPRINT \
    && cat /app/SOURCE_FINGERPRINT

# Set working directory to backend
WORKDIR /app/backend

# Expose the API port
EXPOSE 8002

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8002/api/health || exit 1

# Run the FastAPI server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8002"]
